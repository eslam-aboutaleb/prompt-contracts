{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eslam-aboutaleb/prompt-contracts/schemas/contract-manifest.schema.json",
  "title": "Prompt Contract Manifest",
  "description": "Reference schema for contract.toml manifests (format_version = 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "name",
    "version",
    "renderer",
    "input_schema",
    "output",
    "messages"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1,
      "description": "Contract manifest format version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "description": "Logical contract name using lowercase ASCII letters, digits, dots, and hyphens."
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "description": "Exact semantic version MAJOR.MINOR.PATCH without prerelease or build metadata."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Human-readable description of the contract's responsibility."
    },
    "renderer": {
      "type": "string",
      "enum": [
        "placeholders-v1"
      ],
      "description": "Identifier for the single-pass rendering grammar."
    },
    "input_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Relative POSIX path to the input JSON Schema file."
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Relative POSIX path to the output JSON Schema file (required when mode = 'json')."
        },
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum Unicode code-point length (required when mode = 'text')."
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum Unicode code-point length (required when mode = 'text')."
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "json"
            }
          },
          "required": [
            "schema"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "min_length"
                ]
              },
              {
                "required": [
                  "max_length"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "text"
            }
          },
          "required": [
            "min_length",
            "max_length"
          ],
          "not": {
            "required": [
              "schema"
            ]
          }
        }
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "file"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
